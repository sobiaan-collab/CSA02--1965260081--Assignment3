#include <stdio.h>

#define MAX 10000

long long cmp, moves;

void bubble(int a[], int n)
{
    cmp = moves = 0;

    for (int end = n - 1; end > 0; --end) {
        int swapped = 0;

        for (int j = 0; j < end; ++j) {
            cmp++;

            if (a[j] > a[j + 1]) {
                int t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;

                moves += 3;
                swapped = 1;
            }
        }

        if (!swapped)
            break;
    }
}

void selection(int a[], int n)
{
    cmp = moves = 0;

    for (int i = 0; i < n - 1; ++i) {
        int min = i;

        for (int j = i + 1; j < n; ++j) {
            cmp++;

            if (a[j] < a[min])
                min = j;
        }

        if (min != i) {
            int t = a[i];
            a[i] = a[min];
            a[min] = t;

            moves += 3;
        }
    }
}

void insertion(int a[], int n)
{
    cmp = moves = 0;

    for (int i = 1; i < n; ++i) {
        int key = a[i], j = i - 1;

        while (j >= 0) {
            cmp++;

            if (a[j] > key) {
                a[j + 1] = a[j];
                moves++;
                j--;
            }
            else
                break;
        }

        a[j + 1] = key;
        moves++;
    }
}

void print_array(const int a[], int n)
{
    for (int i = 0; i < n; i++)
        printf("%d ", a[i]);

    puts("");
}

int main(void)
{
    int original[] = {42, 17, 33, 8, 25, 11};
    int a[6];

    for (int i = 0; i < 6; i++)
        a[i] = original[i];

    bubble(a, 6);
    printf("Bubble: ");
    print_array(a, 6);
    printf("comparisons=%lld moves=%lld\n", cmp, moves);

    for (int i = 0; i < 6; i++)
        a[i] = original[i];

    selection(a, 6);
    printf("Selection: ");
    print_array(a, 6);
    printf("comparisons=%lld moves=%lld\n", cmp, moves);

    for (int i = 0; i < 6; i++)
        a[i] = original[i];

    insertion(a, 6);
    printf("Insertion: ");
    print_array(a, 6);
    printf("comparisons=%lld moves=%lld\n", cmp, moves);

    return 0;
}
